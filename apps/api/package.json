    "tsc-alias": "^1.8.17"
  },
  "peerDependencies": {
    "typescript": "^5"
  },
  "dependencies": {
    "@agenrix/authentication": "workspace:*",
    "@agenrix/logger": "workspace:*",
    "@agenrix/pg": "workspace:*",
    "hono": "^4.12.18",
    "hono-pino": "^0.10.3",
    "inversify": "^8.1.0",
    "pino": "^10.3.1",
    "pino-pretty": "^13.1.3",
    "reflect-metadata": "^0.2.2",
    "ulid": "^3.0.2",
    "zod": "^4.4.3"
  }
